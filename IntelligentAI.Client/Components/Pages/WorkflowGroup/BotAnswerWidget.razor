<div>
    <h5 class="card-title">Bot Answer</h5>

    <input type="text" class="form-control"
           @bind-value="Node.Answer"
           placeholder="Answer"/>

    @foreach (var port in Node.Ports)
    {
        <Blazor.Diagrams.Components.Renderers.PortRenderer @key="port" Port="port"></Blazor.Diagrams.Components.Renderers.PortRenderer>
    }
</div>

@code {
    [Parameter]
    public BotAnswerNode Node { get; set; }
}